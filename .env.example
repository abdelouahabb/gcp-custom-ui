# CloudPulse 2026 — Optional Environment Configuration
# Copy this file to .env if you want to override defaults.
# By default, CloudPulse 2026 automatically discovers local gcloud ADC credentials,
# Cloud Run Metadata Server tokens, or lets users sign in via the UI Onboarding Gate.

PORT=4000

# Optional: Custom Google OAuth 2.0 Web/Desktop Client (defaults to official Google Cloud SDK public client)
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
