# ============================================================================
# CloudPulse 2026 — Runtime Environment Configuration (.env.example)
# Copy to .env if you want to override default ports or hosts:
#   cp .env.example .env
#
# Never commit real API keys, OAuth tokens, or GCP Project IDs to git!
# ============================================================================

# Express Backend API & WebSocket Bridge (server/index.js)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
PORT=4000

# Vite Frontend Dev Server (vite.config.js)
VITE_HOST=0.0.0.0
VITE_PORT=5173

# Optional: Explicit proxy target override for /api/* (defaults to http://${BACKEND_HOST}:${BACKEND_PORT})
# VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Automatically start & watch server/index.js when running `npm run dev` (true | false)
VITE_AUTO_START_BACKEND=true
